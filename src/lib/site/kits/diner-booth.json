          "variant": "numbered",
          "items": [
            {
              "title": "January freeze",
              "body": "We still come. The lot is salted. Machines hate the door blast; we sit inward."
            },
            {
              "title": "Summer tourists",
              "body": "We sew earlier so the back row is ours before the weekend crowd."
            },
            {
              "title": "Anniversary pie",
              "body": "The diner's pie, our treat, once a year. Still no cutting on the laminate."
            }
