          "items": [
            {
              "title": "Month 1",
              "body": "Grain, 1/4 inch, nine-patch. You will unpick. That is the class."
            },
            {
              "title": "Month 2",
              "body": "Sashing and borders. Press toward the dark. Square the top."
            },
            {
              "title": "Month 3",
              "body": "Baste, quilt in the ditch or a simple grid, trim."
            },
            {
              "title": "Month 4",
              "body": "Bind. Label. Photograph. Then we talk about quilt two."
            }
          ],
          "style": {
            "bg": "tint",
