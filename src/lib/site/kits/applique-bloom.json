            "bg": "none",
            "width": "narrow",
            "align": "center",
            "spacing": "airy"
          }
        },
        {
          "type": "rich_text",
          "id": "a-body",
          "variant": "two_column",
          "html": "<p>Meetings open with a short business session and a program on a technique: prepared-edge, reverse applique, Broderie Perse, or the setting of a Baltimore Album. Show and tell is untimed.</p><p>The library holds out-of-print Baltimore books and a box of freezer-paper templates members may copy.</p>",
          "style": {
            "bg": "tint",
            "layout": "framed",
            "divider": "rule"
          }
        },
        {
          "type": "testimonials",
          "id": "a-quotes",
          "variant": "grid",
          "items": [
            {
              "quote": "I had never turned a needle in my life. Someone sat next to me and showed me the hitch stitch on a leaf.",
              "author": "Clara W."
            },
            {
              "quote": "The holiday tea is worth the dues by itself. Every wreath block from the year is on the wall.",
              "author": "Margaret L."
            }
          ],
          "style": {
            "bg": "none"
          }
        },
