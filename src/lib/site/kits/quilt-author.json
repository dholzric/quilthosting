          }
        },
        {
          "type": "rich_text",
          "id": "tour-host",
          "variant": "prose",
          "heading": "Hosting a stop",
          "html": "<p>A stop is an evening lecture, or a lecture plus a next-day workshop for twenty. The guild provides the room, the projector, and one hotel night; the books table handles itself with two volunteers and a pen that signs quilts too, if you ask nicely.</p>",
          "style": {
            "bg": "tint",
            "width": "narrow",
            "motion": "piece_in"
