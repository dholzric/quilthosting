        },
        {
          "type": "meeting_info",
          "id": "when",
          "heading": "Clue night",
          "when": "{{meeting_info}}",
          "where": "the room we rent in {{city}}",
          "note": "Envelopes on the chair. Do not open the next one. If you came late, you still do not skip ahead.",
          "style": {
            "bg": "none"
          }
        },
        {
          "type": "events",
