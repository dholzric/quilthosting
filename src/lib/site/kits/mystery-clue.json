          "eyebrow": "Mystery quilts in {{city}}",
          "title": "{{guild_name}}",
          "subtitle": "Sample text — replace me: {{guild_name}} runs one mystery a year. We meet {{meeting_info}}. Clues stay sealed until the night they open. Guessing is sport. Opening early is a small disgrace.",
          "ctaLabel": "Join",
          "ctaHref": "/membership",
          "secondaryLabel": "Clues",
          "secondaryHref": "/clues",
