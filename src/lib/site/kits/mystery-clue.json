      "title": "Clues",
      "nav": true,
      "navLabel": "Clues",
      "sections": [
        {
          "type": "hero",
          "id": "s-hero",
          "variant": "pattern",
          "title": "Clues",
          "subtitle": "Sample text — replace me: How a clue is written, sealed, and not spoiled in the group chat.",
          "style": {
            "bg": "none",
            "align": "center"
          }
        },
        {
          "type": "rich_text",
          "id": "cl-body",
          "variant": "prose",
          "heading": "No peeking",
          "html": "<p><em>Sample text — replace me:</em> The group chat is for missing rotary blades, not for reverse-engineering clue four from a shadow on the floor. If you figure it out, keep it. Bragging is a spoiler.</p>",
          "style": {
            "bg": "tint",
            "width": "narrow",
            "divider": "notch"
          }
        },
        {
          "type": "faq",
          "id": "cl-faq",
          "items": [
            {
              "q": "What if I miss a month?",
              "a": "The envelope waits. You do not get next month's until you open this one in order."
            },
            {
              "q": "Can I look up the commercial mystery online?",
              "a": "You can. You will be asked not to tell. The honor is the whole game."
            }
          ],
          "style": {
            "bg": "none",
            "width": "narrow",
            "layout": "framed"
          }
        }
      ]
    },
