          "id": "j-faq",
          "items": [
            {
              "q": "I hate surprises.",
              "a": "This will be a long year. A BOM with a picture might love you more."
            },
            {
              "q": "Who writes the clues?",
              "a": "A rotating pair. They sew the quilt first, in secret, in a basement we do not discuss."
            }
