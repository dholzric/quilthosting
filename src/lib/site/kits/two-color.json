          "type": "faq",
          "id": "r-faq",
          "items": [
            {
              "q": "Is a selvedge a third fabric?",
              "a": "If it shows, yes. Hide it or own the crime."
            },
            {
              "q": "May the back be different?",
              "a": "The back may be a third. The front is the religion."
            },
            {
              "q": "What about a pieced binding?",
              "a": "Binding from the two. A pieced binding from a third is how we start arguments."
            }
