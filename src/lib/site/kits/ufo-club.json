      "nav": true,
      "navLabel": "Piles",
      "sections": [
        {
          "type": "hero",
          "id": "s-hero",
          "variant": "pattern",
          "title": "The Pile Rules",
          "subtitle": "Sample text — replace me: How we decide what gets finished, gifted, or given away.",
          "style": {
            "bg": "none",
            "align": "center"
          }
        },
        {
          "type": "feature_grid",
          "id": "p-rules",
          "variant": "numbered",
          "items": [
            {
              "title": "Name three",
              "body": "At the first meeting you write three UFOs. Those are the only ones you may work on until they are bound."
            },
            {
              "title": "No new cuts",
              "body": "A new top is allowed after a finish, not before. The fat-quarter fine is real."
            },
            {
              "title": "Gift or let go",
              "body": "If a bag has not moved in two years, it goes on the destash table or to a friend who will sew it."
            }
          ],
          "style": {
            "bg": "tint",
            "width": "wide",
            "divider": "scallop",
            "motion": "piece_in"
          }
        },
        {
          "type": "faq",
          "id": "p-faq",
          "items": [
            {
              "q": "What counts as a finish?",
              "a": "Bound, labeled, and photographed. A quilted sandwich still in a bag is not a finish."
            },
            {
              "q": "May I buy fabric?",
              "a": "Yes. You may not cut a new top from it until a named UFO is done."
            }
          ],
          "style": {
            "bg": "none",
            "width": "narrow",
            "layout": "framed",
            "motion": "piece_in"
          }
        }
      ]
