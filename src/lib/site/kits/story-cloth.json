      "slug": "home",
      "title": "Home",
      "nav": false,
      "sections": [
        {
          "type": "hero",
          "variant": "split",
          "eyebrow": "A community textile archive",
          "title": "Every quilt carries more than pattern.",
          "subtitle": "Story Cloth records the makers, uses, migrations, repairs, and family language held in cloth.",
          "style": {
            "bg": "none",
            "width": "wide",
            "spacing": "airy",
            "imageId": "hero-art",
            "layout": "asym_reverse",
            "media": "left"
          },
          "ctaLabel": "Bring a quilt story",
          "ctaHref": "/documentation-days",
          "secondaryLabel": "Enter the archive",
          "secondaryHref": "/the-archive",
          "id": "home-1"
        },
        {
          "type": "rich_text",
          "variant": "prose",
          "heading": "The record begins with listening.",
          "html": "<p>A date and pattern name are useful. A maker’s own words, uncertainty, corrections, and family context make the record whole.</p>",
          "style": {
            "bg": "tint",
            "width": "narrow",
            "spacing": "airy",
            "motion": "piece_in"
          },
          "id": "home-2"
        },
        {
          "type": "feature_grid",
          "variant": "cards",
          "heading": "Three parts of the archive",
          "items": [
            {
              "title": "Object record",
              "body": "Dimensions, materials, construction, condition, labels, and photographs."
            },
            {
              "title": "Oral history",
              "body": "A consented conversation in the speaker’s own language."
            },
            {
              "title": "Connected lives",
              "body": "Makers, recipients, places, occasions, and later caretakers."
            }
          ],
          "style": {
            "bg": "none",
            "width": "wide",
            "spacing": "airy",
            "motion": "piece_in"
          },
          "id": "home-3"
        },
        {
          "type": "events",
          "variant": "cards",
          "heading": "Documentation days",
          "limit": 3,
          "style": {
            "bg": "brand",
            "width": "wide",
            "spacing": "airy",
            "motion": "piece_in"
          },
          "id": "home-4"
        },
        {
          "type": "rich_text",
          "variant": "prose",
          "heading": "Make this your own",
          "html": "<p><em>Sample text — replace me:</em> Replace sample claims with your collection policy, consent process, access rules, partners, and archive records.</p>",
