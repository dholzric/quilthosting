      "title": "The archive",
      "nav": true,
      "sections": [
        {
          "type": "hero",
          "variant": "minimal",
          "eyebrow": "The archive",
          "title": "Preserve the record without taking the story away.",
          "subtitle": "Explain stewardship, ownership, access, privacy, and how records are corrected.",
          "style": {
            "bg": "none",
            "width": "wide",
            "spacing": "airy"
          },
          "id": "archive-1"
        },
        {
          "type": "image",
          "variant": "full_bleed",
          "items": [
            {
              "imageId": "hero-art",
              "alt": "Original Story Cloth archive study; replace with consented object photography.",
              "caption": "Original Story Cloth archive study; replace with consented object photography."
            }
          ],
          "style": {
            "bg": "none",
            "width": "full",
            "spacing": "airy",
            "motion": "piece_in"
          },
          "id": "archive-2"
        },
        {
          "type": "feature_grid",
          "variant": "cards",
          "heading": "A trustworthy record",
          "items": [
            {
              "title": "Consent",
              "body": "Participants choose what is recorded, shared, restricted, or withdrawn."
            },
            {
              "title": "Context",
              "body": "Facts, memories, uncertainty, and differing accounts are labeled clearly."
            },
            {
              "title": "Access",
              "body": "Search, reuse, and reproduction terms are visible before contribution."
            }
          ],
          "style": {
            "bg": "tint",
            "width": "wide",
            "spacing": "airy",
            "motion": "piece_in"
          },
          "id": "archive-3"
        },
        {
          "type": "rich_text",
          "variant": "prose",
          "heading": "Make this your own",
          "html": "<p><em>Sample text — replace me:</em> Publish the actual deed of gift or license, privacy terms, retention policy, and correction process.</p>",
          "style": {
            "bg": "tint",
            "width": "narrow",
            "spacing": "tight",
            "motion": "piece_in"
          },
          "id": "archive-4"
        }
      ]
    },
    {
      "slug": "documentation-days",
      "title": "Documentation days",
      "nav": true,
      "sections": [
        {
          "type": "hero",
          "variant": "minimal",
          "eyebrow": "Documentation days",
          "title": "Bring one quilt. Leave with a better record.",
          "subtitle": "Set appointments, preparation, handling, photography, and consent expectations.",
          "style": {
            "bg": "none",
            "width": "wide",
            "spacing": "airy"
          },
          "id": "doc-1"
        },
        {
          "type": "feature_grid",
          "variant": "numbered",
          "heading": "What happens",
          "items": [
            {
              "title": "Welcome + consent",
              "body": "Review the process and choose a participation level."
            },
            {
              "title": "Measure + photograph",
              "body": "Create an object record with color target, scale, front, back, and details."
            },
            {
              "title": "Listen + return",
              "body": "Record the known story, note questions, and confirm next steps."
            }
          ],
          "style": {
            "bg": "brand",
            "width": "wide",
            "spacing": "airy",
            "motion": "piece_in"
          },
          "id": "doc-2"
        },
        {
          "type": "faq",
          "heading": "Before your appointment",
          "items": [
            {
              "q": "Do you keep the quilt?",
              "a": "State clearly whether this is documentation only or an acquisition program."
            },
            {
              "q": "Who owns the photographs?",
              "a": "Explain copyright, participant license, archive use, and download access."
            },
            {
              "q": "May family details stay private?",
              "a": "Offer defined restriction choices and explain their duration."
            }
          ],
          "style": {
            "bg": "tint",
            "width": "narrow",
            "spacing": "airy",
            "motion": "piece_in"
          },
          "id": "doc-3"
        },
        {
          "type": "rich_text",
          "variant": "prose",
          "heading": "Make this your own",
          "html": "<p><em>Sample text — replace me:</em> Replace with counsel-reviewed consent, privacy, copyright, handling, and retention terms.</p>",
          "style": {
            "bg": "tint",
            "width": "narrow",
            "spacing": "tight",
            "motion": "piece_in"
          },
          "id": "doc-4"
        }
      ]
    },
