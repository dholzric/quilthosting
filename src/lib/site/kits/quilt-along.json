            "bg": "none",
            "align": "center"
          }
        },
        {
          "type": "rich_text",
          "id": "a-body",
          "variant": "two_column",
          "html": "<p>I write patterns I can finish in a season of weeknights. The QAL exists because people asked for a shared calendar, not because the math required one.</p><p>Errata go on the blog the same day I find them.</p>",
          "style": {
            "bg": "tint",
            "divider": "scallop"
          }
        },
