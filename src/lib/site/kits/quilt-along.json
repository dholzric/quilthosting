            },
            {
              "q": "Can a guild sew it together?",
              "a": "Yes. Buy one pattern per sewist. A guild booking for a live sew is on the workshops page."
            }
          ],
          "style": {
            "bg": "tint",
            "width": "narrow",
            "layout": "framed",
            "divider": "scallop"
          }
