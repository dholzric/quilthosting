{
  "name": "quilthosting",
  "version": "0.45.0-preview",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply quilthosting-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply quilthosting-db --remote",
    "db:create": "wrangler d1 create quilthosting-db",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scale": "node scripts/verify-scale.mjs",
    "test:integrations": "node scripts/verify-integrations.mjs",
    "test:idempotency": "node scripts/verify-idempotency.mjs",
    "test:import": "node scripts/verify-import.mjs",
    "test:delivery": "node scripts/verify-delivery.mjs",
    "test:business-site": "node scripts/verify-business-site.mjs"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.14.0"
  }
}
